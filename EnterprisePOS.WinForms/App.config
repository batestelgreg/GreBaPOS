<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- Standalone or LAN -->
		<add key="DatabaseConnectionMode" value="Standalone" />

		<!-- Standalone: .\SQLEXPRESS -->
		<!-- LAN example: 192.168.1.100\SQLEXPRESS -->
		<add key="DatabaseServerName" value=".\SQLEXPRESS" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0"
                          sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>